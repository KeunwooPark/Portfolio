---
layout: none
---
{% assign blog_posts = site.blog | sort: 'publish_date' | reverse %}[{% for post in blog_posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | jsonify }},"excerpt":{{ post.excerpt | strip_html | truncate: 300 | jsonify }},"date":{{ post.publish_date | date: "%B %-d, %Y" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
